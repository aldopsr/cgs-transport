{
  "provider": "php",
  "phpVersion": "8.3",
  "buildAptPackages": [
    "bison",
    "re2c",
    "libgd-dev",
    "libzip-dev",
    "libxml2-dev",
    "libcurl4-openssl-dev",
    "libssl-dev",
    "libonig-dev"
  ],
  "phpExtensions": [
    "gd",
    "pdo_mysql",
    "mbstring",
    "xml",
    "zip",
    "curl",
    "bcmath",
    "fileinfo",
    "tokenizer"
  ],
  "install": {
    "cmd": "composer install --no-dev --optimize-autoloader --no-scripts --no-interaction --ignore-platform-reqs"
  },
  "build": {
    "cmds": [
      "php artisan storage:link || true",
      "php artisan config:cache",
      "php artisan route:cache",
      "php artisan view:cache"
    ]
  },
  "deploy": {
    "cmds": [
      "php artisan migrate --force"
    ],
    "startCmd": "php artisan serve --host 0.0.0.0 --port $PORT"
  }
}
